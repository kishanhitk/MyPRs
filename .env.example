# Supabase — exposed to the browser (public anon key is safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog analytics (client-side)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Absolute site origin, used for metadataBase (OG image URLs). Optional.
NEXT_PUBLIC_SITE_URL=https://myprs.xyz

# GitHub token (server-only). Optional but strongly recommended — lifts the
# unauthenticated 60 req/hr limit to 5000 req/hr for the PR search API.
GITHUB_TOKEN=
